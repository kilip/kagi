// RateLimitCreateHook is a hook function invoked before saving a new rate limit builder.
type RateLimitCreateHook func(ctx context.Context, b *{{ $rateLimitNode.CreateName }}, key string) error

// RateLimitStoreOption configures a KagiRateLimitStore.
type RateLimitStoreOption func(*KagiRateLimitStore)

// WithRateLimitCreateHook registers a hook to be executed prior to creating a rate limit record.
func WithRateLimitCreateHook(hook RateLimitCreateHook) RateLimitStoreOption {
	return func(s *KagiRateLimitStore) {
		s.createHooks = append(s.createHooks, hook)
	}
}

// KagiRateLimitStore implements kagi.RateLimitStore using the ent client.
// It uses a sync.Mutex combined with database transactions to ensure thread safety
// under concurrent goroutines without SQLite table lock contention.
type KagiRateLimitStore struct {
	client      *Client
	mu          sync.Mutex
	createHooks []RateLimitCreateHook
}

// NewKagiRateLimitStore creates a new kagi.RateLimitStore backed by ent.
func NewKagiRateLimitStore(client *Client, opts ...RateLimitStoreOption) *KagiRateLimitStore {
	s := &KagiRateLimitStore{client: client}
	for _, opt := range opts {
		opt(s)
	}
	return s
}

var _ kagi.RateLimitStore = (*KagiRateLimitStore)(nil)

// Increment atomically increments the request counter for key within a fixed time window (ADR-0004).
func (s *KagiRateLimitStore) Increment(ctx context.Context, key string, window time.Duration) (int, error) {
	if err := ctx.Err(); err != nil {
		return 0, err
	}

	s.mu.Lock()
	defer s.mu.Unlock()

	tx, err := s.client.Tx(ctx)
	if err != nil {
		return 0, err
	}
	defer func() {
		_ = tx.Rollback()
	}()

	now := time.Now().UTC()
	entry, err := tx.{{ $rateLimitNode.Name }}.Query().
		Where({{ $rateLimitNode.Package }}.KeyEQ(key)).
		Only(ctx)
	if err != nil {
		if !IsNotFound(err) {
			return 0, err
		}
		// Entry does not exist: create with count = 1 and expires_at = now + window
		newExpiresAt := now.Add(window)
		builder := tx.{{ $rateLimitNode.Name }}.Create().
			SetKey(key).
			SetCount(1).
			SetExpiresAt(newExpiresAt)
		for _, hook := range s.createHooks {
			if err := hook(ctx, builder, key); err != nil {
				return 0, err
			}
		}
		_, err := builder.Save(ctx)
		if err != nil {
			return 0, err
		}
		if err := tx.Commit(); err != nil {
			return 0, err
		}
		return 1, nil
	}

	// Entry exists
	if !entry.ExpiresAt.After(now) {
		// Expired: reset count = 1 and expires_at = now + window
		newExpiresAt := now.Add(window)
		err := tx.{{ $rateLimitNode.Name }}.UpdateOneID(entry.ID).
			SetCount(1).
			SetExpiresAt(newExpiresAt).
			Exec(ctx)
		if err != nil {
			return 0, err
		}
		if err := tx.Commit(); err != nil {
			return 0, err
		}
		return 1, nil
	}

	// Active: increment count = count + 1, strictly preserving expires_at
	newCount := entry.Count + 1
	err = tx.{{ $rateLimitNode.Name }}.UpdateOneID(entry.ID).
		SetCount(newCount).
		Exec(ctx)
	if err != nil {
		return 0, err
	}
	if err := tx.Commit(); err != nil {
		return 0, err
	}

	return newCount, nil
}

// DeleteExpired removes expired rate limit counter entries in bounded batches up to batchSize (ADR-0010).
func (s *KagiRateLimitStore) DeleteExpired(ctx context.Context, batchSize int) (int, error) {
	if batchSize <= 0 {
		return 0, nil
	}

	s.mu.Lock()
	defer s.mu.Unlock()

	now := time.Now().UTC()
	expiredEntities, err := s.client.{{ $rateLimitNode.Name }}.Query().
		Where({{ $rateLimitNode.Package }}.ExpiresAtLTE(now)).
		Limit(batchSize).
		All(ctx)
	if err != nil {
		return 0, err
	}
	if len(expiredEntities) == 0 {
		return 0, nil
	}

	ids := make([]{{ if $rateLimitNode.ID.IsInt }}int{{ else if $rateLimitNode.ID.IsInt64 }}int64{{ else if $rateLimitNode.ID.IsUUID }}uuid.UUID{{ else }}string{{ end }}, len(expiredEntities))
	for i, entity := range expiredEntities {
		ids[i] = entity.ID
	}

	affected, err := s.client.{{ $rateLimitNode.Name }}.Delete().
		Where({{ $rateLimitNode.Package }}.IDIn(ids...)).
		Exec(ctx)
	if err != nil {
		return 0, err
	}

	return affected, nil
}
