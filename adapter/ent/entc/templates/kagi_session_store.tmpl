		{{- else if $sessionNode.ID.IsString -}}
		ID: entity.ID,
		{{- else if $sessionNode.ID.IsUUID -}}
		ID: entity.ID.String(),
		{{- else -}}
		ID: strconv.Itoa(entity.ID),
