// ListByUserID retrieves all active, unexpired, non-pending sessions for userID.
func (s *KagiSessionStore) ListByUserID(ctx context.Context, userID string) ([]*kagi.Session, error) {
	now := time.Now().UTC()
	entities, err := s.client.{{ $sessionNode.Name }}.Query().
		Where(
			{{ $sessionNode.Package }}.UserIDEQ(userID),
			{{ $sessionNode.Package }}.ExpiresAtGT(now),
			{{ $sessionNode.Package }}.Pending2faEQ(false),
		).
		All(ctx)
	if err != nil {
		return nil, err
	}

	sessions := make([]*kagi.Session, len(entities))
	for i, entity := range entities {
		sessions[i] = s.toKagiSession(entity)
	}
	return sessions, nil
}

// DeleteExpired removes expired sessions from storage in bounded batches up to batchSize.
func (s *KagiSessionStore) DeleteExpired(ctx context.Context, batchSize int) (int, error) {
	if batchSize <= 0 {
		return 0, nil
	}

	now := time.Now().UTC()
	expiredEntities, err := s.client.{{ $sessionNode.Name }}.Query().
		Where({{ $sessionNode.Package }}.ExpiresAtLTE(now)).
		Limit(batchSize).
		All(ctx)
	if err != nil {
		return 0, err
	}
	if len(expiredEntities) == 0 {
		return 0, nil
	}

	ids := make([]{{ if $sessionNode.ID.IsInt }}int{{ else if $sessionNode.ID.IsInt64 }}int64{{ else if $sessionNode.ID.IsUUID }}uuid.UUID{{ else }}string{{ end }}, len(expiredEntities))
	for i, entity := range expiredEntities {
		ids[i] = entity.ID
	}

	affected, err := s.client.{{ $sessionNode.Name }}.Delete().
		Where({{ $sessionNode.Package }}.IDIn(ids...)).
		Exec(ctx)
	if err != nil {
		return 0, err
	}

	return affected, nil
}

